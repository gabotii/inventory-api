# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (use token_hex for POSTGRES_PASSWORD so it is URL-safe inside DATABASE_URL)

# --- environment ---------------------------------------------------------
# development | test | production. Production refuses insecure settings at startup.
APP_ENV=development
LOG_LEVEL=INFO
# json (production) | console (human-readable, local dev)
LOG_FORMAT=console

# --- database --------------------------------------------------------------
# Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://inventory:CHANGE_ME@127.0.0.1:5432/inventory
# Integration tests only. The database name must contain "test"; it is wiped.
TEST_DATABASE_URL=postgresql+asyncpg://inventory:CHANGE_ME@127.0.0.1:5432/inventory_test
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=15000

# docker compose only
POSTGRES_PASSWORD=CHANGE_ME

# --- authentication ----------------------------------------------------------
# >= 32 random characters in production.
JWT_SECRET=CHANGE_ME
# JWT_ISSUER=inventory-api
# JWT_AUDIENCE=inventory-api
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# Argon2id cost. Production minimum: memory >= 19456 KiB, time >= 2.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=4
# PASSWORD_HASH_CONCURRENCY=4

# --- rate limiting (stored in PostgreSQL, shared by all replicas) ------------
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_EMAIL=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# REFRESH_RATE_LIMIT_PER_IP=60
# REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (empty = none).
CORS_ALLOWED_ORIGINS=
# Swagger UI at /docs and schema at /openapi.json. Default: on, except in production.
# EXPOSE_DOCS=true
# Only behind TLS termination.
ENABLE_HSTS=false
# MAX_REQUEST_BODY_BYTES=1048576

# --- retention ---------------------------------------------------------------
# IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- uvicorn (container) -----------------------------------------------------
# WEB_CONCURRENCY=2
# Proxies whose X-Forwarded-For is trusted for client IPs (rate limiting, audit).
# FORWARDED_ALLOW_IPS=127.0.0.1
